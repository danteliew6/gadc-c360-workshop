            "spec": {"version": 2, "widgetType": "counter", "frame": {"title": "Avg Order Value (₱)", "showTitle": true}, "encodings": {"value": {"fieldName": "measure(Avg Order Value)", "displayName": "AOV", "format": {"type": "number-currency", "currencyCode": "PHP", "decimalPlaces": {"type": "exact", "places": 2}}}}}
          },
          "position": {"x": 6, "y": 2, "width": 3, "height": 3}
        },
        {
          "widget": {
            "name": "kpi_repeat",
            "queries": [{"name": "q", "query": {"datasetName": "ds_members", "fields": [{"name": "measure(Repeat Rate)", "expression": "MEASURE(`Repeat Rate`)"}], "disaggregated": false}}],
            "spec": {"version": 2, "widgetType": "counter", "frame": {"title": "Repeat Rate", "showTitle": true}, "encodings": {"value": {"fieldName": "measure(Repeat Rate)", "displayName": "Repeat Rate", "format": {"type": "number-percent", "decimalPlaces": {"type": "max", "places": 1}}}}}
          },
          "position": {"x": 9, "y": 2, "width": 3, "height": 3}
        },
        {
          "widget": {
            "name": "revenue_trend",
            "queries": [{"name": "q", "query": {"datasetName": "ds_daily", "fields": [{"name": "daily(order_date)", "expression": "DATE_TRUNC(\"DAY\", `order_date`)"}, {"name": "sum(revenue)", "expression": "SUM(`revenue`)"}], "disaggregated": false}}],
            "spec": {"version": 3, "widgetType": "line", "frame": {"title": "Daily net revenue (₱)", "showTitle": true}, "encodings": {"x": {"fieldName": "daily(order_date)", "scale": {"type": "temporal"}, "displayName": "Date"}, "y": {"fieldName": "sum(revenue)", "scale": {"type": "quantitative"}, "displayName": "Revenue"}}}
