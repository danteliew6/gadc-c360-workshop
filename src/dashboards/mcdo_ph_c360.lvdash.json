          "widget": {
            "name": "rfm_bar",
            "queries": [{"name": "q", "query": {"datasetName": "ds_members", "fields": [{"name": "rfm_segment", "expression": "`rfm_segment`"}, {"name": "measure(Members)", "expression": "MEASURE(`Members`)"}], "disaggregated": false}}],
            "spec": {"version": 3, "widgetType": "bar", "frame": {"title": "Members by RFM segment", "showTitle": true}, "encodings": {"x": {"fieldName": "rfm_segment", "scale": {"type": "categorical"}, "displayName": "Segment"}, "y": {"fieldName": "measure(Members)", "scale": {"type": "quantitative"}, "displayName": "Members"}}}
          },
          "position": {"x": 0, "y": 10, "width": 6, "height": 5}
        },
        {
          "widget": {
            "name": "churn_bar",
            "queries": [{"name": "q", "query": {"datasetName": "ds_members", "fields": [{"name": "churn_risk", "expression": "`churn_risk`"}, {"name": "measure(Members)", "expression": "MEASURE(`Members`)"}], "disaggregated": false}}],
            "spec": {"version": 3, "widgetType": "bar", "frame": {"title": "Members by churn risk", "showTitle": true}, "encodings": {"x": {"fieldName": "churn_risk", "scale": {"type": "categorical"}, "displayName": "Churn risk"}, "y": {"fieldName": "measure(Members)", "scale": {"type": "quantitative"}, "displayName": "Members"}, "color": {"fieldName": "churn_risk", "scale": {"type": "categorical", "mappings": [{"value": "High", "color": "#DA291C"}, {"value": "Medium", "color": "#FFC72C"}, {"value": "Low", "color": "#3C7A3C"}, {"value": "N/A — Prospect", "color": "#B0B0B0"}]}}}}
          },
          "position": {"x": 6, "y": 10, "width": 6, "height": 5}
        },
        {
          "widget": {
            "name": "region_bar",
            "queries": [{"name": "q", "query": {"datasetName": "ds_members", "fields": [{"name": "region", "expression": "`region`"}, {"name": "measure(Total Revenue)", "expression": "MEASURE(`Total Revenue`)"}], "disaggregated": false}}],
            "spec": {"version": 3, "widgetType": "bar", "frame": {"title": "Lifetime revenue by region (₱)", "showTitle": true}, "encodings": {"x": {"fieldName": "region", "scale": {"type": "categorical"}, "displayName": "Region"}, "y": {"fieldName": "measure(Total Revenue)", "scale": {"type": "quantitative"}, "displayName": "Revenue"}}}
          },
          "position": {"x": 0, "y": 15, "width": 6, "height": 5}
        },
