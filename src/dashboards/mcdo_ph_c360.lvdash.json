            "spec": {"version": 3, "widgetType": "bar", "frame": {"title": "Revenue by menu category (₱)", "showTitle": true}, "encodings": {"x": {"fieldName": "sum(revenue)", "scale": {"type": "quantitative"}, "displayName": "Revenue"}, "y": {"fieldName": "category", "scale": {"type": "categorical"}, "displayName": "Category"}}}
          },
