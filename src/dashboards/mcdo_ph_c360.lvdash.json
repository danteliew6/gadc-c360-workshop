{
  "datasets": [
    {
      "name": "ds_members",
      "displayName": "Customer 360 (members)",
      "queryLines": [
        "SELECT customer_id, region, province, city, loyalty_tier, rfm_segment, churn_risk,\n",
        "       preferred_channel, signup_channel, favorite_category, favorite_store,\n",
        "       total_orders, total_spend, avg_order_value, clv_estimate, engagement_score,\n",
        "       recency_days, tenure_days, rewards_redeemed, full_name, age\n",
        "FROM dante_classic_stable_catalog.mcdo_ph_gold.customer_360"
      ],
      "columns": [
        {"displayName": "Members", "description": "Distinct loyalty members", "expression": "COUNT(`customer_id`)"},
        {"displayName": "Active Members", "description": "Members with >=1 completed order", "expression": "COUNT(CASE WHEN `total_orders` > 0 THEN `customer_id` END)"},
        {"displayName": "Total Revenue", "description": "Lifetime net revenue", "expression": "SUM(`total_spend`)"},
        {"displayName": "Total Orders", "description": "Lifetime orders", "expression": "SUM(`total_orders`)"},
        {"displayName": "Avg Order Value", "description": "Revenue per order", "expression": "SUM(`total_spend`) / NULLIF(SUM(`total_orders`), 0)"},
        {"displayName": "Repeat Rate", "description": "Share of active members with >1 order", "expression": "COUNT(CASE WHEN `total_orders` > 1 THEN `customer_id` END) * 1.0 / NULLIF(COUNT(CASE WHEN `total_orders` > 0 THEN `customer_id` END), 0)"},
        {"displayName": "High Churn Members", "description": "Members flagged High churn risk", "expression": "COUNT(CASE WHEN `churn_risk` = 'High' THEN `customer_id` END)"},
        {"displayName": "Est CLV", "description": "Sum of estimated customer lifetime value", "expression": "SUM(`clv_estimate`)"}
      ]
    },
    {
      "name": "ds_daily",
      "displayName": "Daily sales",
      "queryLines": [
        "SELECT order_date, region, channel, orders, revenue, active_customers,\n",
        "       avg_order_value, promo_discount\n",
        "FROM dante_classic_stable_catalog.mcdo_ph_gold.daily_sales"
      ]
    },
    {
      "name": "ds_stores",
      "displayName": "Store performance",
      "queryLines": [
        "SELECT store_id, store_name, region, province, city, store_format,\n",
        "       latitude, longitude, orders, revenue, avg_order_value,\n",
        "       unique_customers, drive_thru_share, revenue_per_customer\n",
        "FROM dante_classic_stable_catalog.mcdo_ph_gold.store_performance"
      ]
    },
    {
      "name": "ds_category",
      "displayName": "Category mix",
      "queryLines": [
        "SELECT region, category, is_localized, revenue, units, orders\n",
        "FROM dante_classic_stable_catalog.mcdo_ph_gold.category_mix"
      ]
    }
  ],
  "pages": [
    {
      "name": "overview",
      "displayName": "Customer 360",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "hdr",
            "multilineTextboxSpec": {
              "lines": [
                "# 🍟 McDonald's Philippines — Customer 360\n",
                "**GADC loyalty analytics** · members, spend, retention and network performance. Synthetic demo data. KPIs and segments come from the governed Gold `customer_360` mart; use the **Filters** page to slice by region or tier."
              ]
            }
          },
          "position": {"x": 0, "y": 0, "width": 12, "height": 2}
        },
        {
          "widget": {
            "name": "kpi_active",
            "queries": [{"name": "q", "query": {"datasetName": "ds_members", "fields": [{"name": "measure(Active Members)", "expression": "MEASURE(`Active Members`)"}], "disaggregated": false}}],
            "spec": {"version": 2, "widgetType": "counter", "frame": {"title": "Active Members", "showTitle": true}, "encodings": {"value": {"fieldName": "measure(Active Members)", "displayName": "Active Members", "format": {"type": "number-plain", "decimalPlaces": {"type": "exact", "places": 0}}}}}
          },
          "position": {"x": 0, "y": 2, "width": 3, "height": 3}
        },
        {
          "widget": {
            "name": "kpi_revenue",
            "queries": [{"name": "q", "query": {"datasetName": "ds_members", "fields": [{"name": "measure(Total Revenue)", "expression": "MEASURE(`Total Revenue`)"}], "disaggregated": false}}],
            "spec": {"version": 2, "widgetType": "counter", "frame": {"title": "Lifetime Revenue (₱)", "showTitle": true}, "encodings": {"value": {"fieldName": "measure(Total Revenue)", "displayName": "Revenue", "format": {"type": "number-currency", "currencyCode": "PHP", "decimalPlaces": {"type": "max", "places": 0}, "abbreviation": "compact"}}}}
          },
          "position": {"x": 3, "y": 2, "width": 3, "height": 3}
        },
        {
          "widget": {
