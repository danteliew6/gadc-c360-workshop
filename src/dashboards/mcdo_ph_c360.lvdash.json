            "spec": {"version": 3, "widgetType": "pie", "frame": {"title": "Members by loyalty tier", "showTitle": true}, "encodings": {"angle": {"fieldName": "measure(Members)", "scale": {"type": "quantitative"}, "displayName": "Members"}, "color": {"fieldName": "loyalty_tier", "scale": {"type": "categorical"}, "displayName": "Tier"}, "label": {"show": true}}}
