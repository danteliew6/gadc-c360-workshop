{
  "datasets": [
    {
      "name": "ds_members",
      "displayName": "Member 360 (MyMcDonald's Rewards)",
      "queryLines": [
        "SELECT customer_id, region, province, city, current_tier, qualified_tier, tier_status,\n",
        "       rfm_segment, churn_risk, preferred_channel, favorite_category, full_name,\n",
        "       points_balance, lifetime_points_earned, lifetime_points_redeemed, points_expired,\n",
        "       points_earned_12mo, redemptions_count, redemption_rate, points_liability_php,\n",
        "       total_orders, total_spend, clv_estimate\n",
        "FROM dante_classic_stable_catalog.mcdo_ph_gold.customer_360"
      ],
      "columns": [
        {"displayName": "Members", "description": "Distinct rewards members", "expression": "COUNT(`customer_id`)"},
        {"displayName": "Active Members", "description": "Members with >=1 completed order", "expression": "COUNT(CASE WHEN `total_orders` > 0 THEN `customer_id` END)"},
        {"displayName": "Outstanding Points", "description": "Sum of redeemable point balances", "expression": "SUM(`points_balance`)"},
        {"displayName": "Points Earned", "description": "Lifetime points earned", "expression": "SUM(`lifetime_points_earned`)"},
        {"displayName": "Points Redeemed", "description": "Lifetime points redeemed", "expression": "SUM(`lifetime_points_redeemed`)"},
        {"displayName": "Outstanding Liability", "description": "Estimated peso liability of outstanding points", "expression": "SUM(`points_liability_php`)"},
        {"displayName": "Redemption Rate", "description": "Points redeemed / points earned", "expression": "SUM(`lifetime_points_redeemed`) * 1.0 / NULLIF(SUM(`lifetime_points_earned`), 0)"},
        {"displayName": "Members Redeeming", "description": "Members with >=1 redemption", "expression": "COUNT(CASE WHEN `redemptions_count` > 0 THEN `customer_id` END)"},
        {"displayName": "Downgrade Risk Members", "description": "Held tier above qualified tier", "expression": "COUNT(CASE WHEN `tier_status` = 'Downgrade risk' THEN `customer_id` END)"},
        {"displayName": "Upgrade Eligible Members", "description": "Qualified tier above held tier", "expression": "COUNT(CASE WHEN `tier_status` = 'Upgrade eligible' THEN `customer_id` END)"},
        {"displayName": "Total Revenue", "description": "Lifetime net revenue", "expression": "SUM(`total_spend`)"}
      ]
    },
    {
      "name": "ds_points",
      "displayName": "Points economy (daily)",
      "queryLines": [
        "SELECT txn_date, points_earned, bonus_points, points_redeemed, points_expired,\n",
        "       net_points, redemptions, active_members, outstanding_balance,\n",
        "       outstanding_liability_php\n",
        "FROM dante_classic_stable_catalog.mcdo_ph_gold.points_economy"
      ]
    },
    {
      "name": "ds_rewards",
      "displayName": "Rewards catalog performance",
      "queryLines": [
        "SELECT reward_id, reward_name, reward_tier, category, point_cost, est_value_php,\n",
        "       redemptions, points_spent, unique_members, value_delivered_php, pct_of_redemptions\n",
        "FROM dante_classic_stable_catalog.mcdo_ph_gold.reward_performance"
      ]
    },
    {
      "name": "ds_tiers",
      "displayName": "Tier migration",
      "queryLines": [
        "SELECT current_tier, current_tier_rank, qualified_tier, qualified_tier_rank,\n",
        "       tier_status, members, points_balance, points_liability_php\n",
        "FROM dante_classic_stable_catalog.mcdo_ph_gold.tier_migration"
      ]
    }
  ],
  "pages": [
    {
      "name": "overview",
      "displayName": "Membership Overview",
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1",
      "layout": [
        {
          "widget": {
            "name": "hdr",
            "multilineTextboxSpec": {
              "lines": [
                "# 🍟 MyMcDonald's Rewards — Membership Analytics\n",
                "**McDonald's Philippines (GADC)** · the loyalty **points economy** — earn, redeem, breakage, outstanding liability, and status-tier health. Synthetic demo data from the governed Gold `customer_360` mart and points-economy marts. Use the **Filters** page to slice by region and tier."
              ]
            }
          },
          "position": {"x": 0, "y": 0, "width": 12, "height": 2}
        },
        {
          "widget": {
            "name": "kpi_active",
            "queries": [{"name": "main_query", "query": {"datasetName": "ds_members", "fields": [{"name": "measure(Active Members)", "expression": "MEASURE(`Active Members`)"}], "disaggregated": false}}],
            "spec": {"version": 2, "widgetType": "counter", "frame": {"title": "Active Members", "showTitle": true}, "encodings": {"value": {"fieldName": "measure(Active Members)", "displayName": "Active Members", "format": {"type": "number-plain", "decimalPlaces": {"type": "exact", "places": 0}}}}}
          },
          "position": {"x": 0, "y": 2, "width": 3, "height": 3}
        },
        {
          "widget": {
            "name": "kpi_points",
            "queries": [{"name": "main_query", "query": {"datasetName": "ds_members", "fields": [{"name": "measure(Outstanding Points)", "expression": "MEASURE(`Outstanding Points`)"}], "disaggregated": false}}],
            "spec": {"version": 2, "widgetType": "counter", "frame": {"title": "Outstanding Points", "showTitle": true}, "encodings": {"value": {"fieldName": "measure(Outstanding Points)", "displayName": "Points", "format": {"type": "number-plain", "decimalPlaces": {"type": "max", "places": 0}, "abbreviation": "compact"}}}}
          },
          "position": {"x": 3, "y": 2, "width": 3, "height": 3}
        },
        {
          "widget": {
            "name": "kpi_liability",
            "queries": [{"name": "main_query", "query": {"datasetName": "ds_members", "fields": [{"name": "measure(Outstanding Liability)", "expression": "MEASURE(`Outstanding Liability`)"}], "disaggregated": false}}],
            "spec": {"version": 2, "widgetType": "counter", "frame": {"title": "Outstanding Liability (₱)", "showTitle": true}, "encodings": {"value": {"fieldName": "measure(Outstanding Liability)", "displayName": "Liability", "format": {"type": "number-currency", "currencyCode": "PHP", "decimalPlaces": {"type": "max", "places": 1}, "abbreviation": "compact"}}}}
          },
          "position": {"x": 6, "y": 2, "width": 3, "height": 3}
        },
        {
          "widget": {
            "name": "kpi_redrate",
            "queries": [{"name": "main_query", "query": {"datasetName": "ds_members", "fields": [{"name": "measure(Redemption Rate)", "expression": "MEASURE(`Redemption Rate`)"}], "disaggregated": false}}],
            "spec": {"version": 2, "widgetType": "counter", "frame": {"title": "Redemption Rate", "showTitle": true}, "encodings": {"value": {"fieldName": "measure(Redemption Rate)", "displayName": "Redemption Rate", "format": {"type": "number-percent", "decimalPlaces": {"type": "max", "places": 1}}}}}
          },
          "position": {"x": 9, "y": 2, "width": 3, "height": 3}
        },
        {
          "widget": {
            "name": "liability_trend",
            "queries": [{"name": "main_query", "query": {"datasetName": "ds_points", "fields": [{"name": "monthly(txn_date)", "expression": "DATE_TRUNC(\"MONTH\", `txn_date`)"}, {"name": "max(outstanding_liability_php)", "expression": "MAX(`outstanding_liability_php`)"}], "disaggregated": false}}],
            "spec": {"version": 3, "widgetType": "line", "frame": {"title": "Outstanding points liability (₱, month-end)", "showTitle": true}, "encodings": {"x": {"fieldName": "monthly(txn_date)", "scale": {"type": "temporal"}, "displayName": "Month"}, "y": {"fieldName": "max(outstanding_liability_php)", "scale": {"type": "quantitative"}, "displayName": "Liability (₱)"}}}
          },
          "position": {"x": 0, "y": 5, "width": 8, "height": 5}
        },
        {
          "widget": {
            "name": "tier_pie",
            "queries": [{"name": "main_query", "query": {"datasetName": "ds_members", "fields": [{"name": "measure(Members)", "expression": "MEASURE(`Members`)"}, {"name": "current_tier", "expression": "`current_tier`"}], "disaggregated": false}}],
            "spec": {"version": 3, "widgetType": "pie", "frame": {"title": "Members by status tier", "showTitle": true}, "encodings": {"angle": {"fieldName": "measure(Members)", "scale": {"type": "quantitative"}, "displayName": "Members"}, "color": {"fieldName": "current_tier", "scale": {"type": "categorical"}, "displayName": "Tier"}, "label": {"show": true}}}
          },
          "position": {"x": 8, "y": 5, "width": 4, "height": 5}
        },
        {
          "widget": {
            "name": "tier_status_bar",
            "queries": [{"name": "main_query", "query": {"datasetName": "ds_members", "fields": [{"name": "tier_status", "expression": "`tier_status`"}, {"name": "measure(Members)", "expression": "MEASURE(`Members`)"}], "disaggregated": false}}],
            "spec": {"version": 3, "widgetType": "bar", "frame": {"title": "Members by tier status", "showTitle": true}, "encodings": {"x": {"fieldName": "tier_status", "scale": {"type": "categorical"}, "displayName": "Tier status"}, "y": {"fieldName": "measure(Members)", "scale": {"type": "quantitative"}, "displayName": "Members"}, "color": {"fieldName": "tier_status", "scale": {"type": "categorical", "mappings": [{"value": "Downgrade risk", "color": "#DA291C"}, {"value": "Upgrade eligible", "color": "#FFC72C"}, {"value": "On track", "color": "#3C7A3C"}]}}}}
          },
          "position": {"x": 0, "y": 10, "width": 6, "height": 5}
        },
        {
          "widget": {
            "name": "region_liability_bar",
            "queries": [{"name": "main_query", "query": {"datasetName": "ds_members", "fields": [{"name": "region", "expression": "`region`"}, {"name": "measure(Outstanding Liability)", "expression": "MEASURE(`Outstanding Liability`)"}], "disaggregated": false, "orders": [{"direction": "DESC", "expression": "MEASURE(`Outstanding Liability`)"}]}}],
            "spec": {"version": 3, "widgetType": "bar", "frame": {"title": "Points liability by region (₱)", "showTitle": true}, "encodings": {"x": {"fieldName": "region", "scale": {"type": "categorical"}, "displayName": "Region"}, "y": {"fieldName": "measure(Outstanding Liability)", "scale": {"type": "quantitative"}, "displayName": "Liability (₱)"}}}
          },
          "position": {"x": 6, "y": 10, "width": 6, "height": 5}
        },
        {
          "widget": {
            "name": "top_members",
            "queries": [{"name": "main_query", "query": {"datasetName": "ds_members", "fields": [{"name": "full_name", "expression": "`full_name`"}, {"name": "region", "expression": "`region`"}, {"name": "current_tier", "expression": "`current_tier`"}, {"name": "qualified_tier", "expression": "`qualified_tier`"}, {"name": "tier_status", "expression": "`tier_status`"}, {"name": "points_balance", "expression": "`points_balance`"}, {"name": "lifetime_points_earned", "expression": "`lifetime_points_earned`"}, {"name": "redemptions_count", "expression": "`redemptions_count`"}, {"name": "total_spend", "expression": "`total_spend`"}], "disaggregated": true, "orders": [{"direction": "DESC", "expression": "`points_balance`"}]}}],
